# QuoteMint environment. Copy to .env and adjust.
# QuoteMint 环境变量样板：复制为 .env 后按需修改。
PORT=3000
BASE_URL=http://localhost:3000
DATA_DIR=./data

# Billing. Provider is auto-selected: CREEM_API_KEY wins, else Stripe, else billing disabled.
# 计费提供商自动选择：设了 CREEM_API_KEY 用 Creem，否则 Stripe，都没有则计费关闭。
# DEMO_MODE=true adds the demo upgrade button and seeds demo credentials. NEVER enable in production.
# DEMO_MODE=true 会显示演示升级按钮并允许 seed 演示账号。生产环境绝不能开启。
DEMO_MODE=false

# Creem (primary; works for individual sellers in mainland China). Keys from creem.io dashboard.
# Creem（首选；中国大陆个人可注册）。密钥在 creem.io 控制台获取。
CREEM_API_KEY=
CREEM_PRODUCT_ID=
CREEM_WEBHOOK_SECRET=
# Optional override for testing against a local stub; leave empty in production.
# 可选：测试时指向本地模拟服务；生产环境留空。
CREEM_API_BASE=

# Stripe (optional alternative, requires an entity Stripe supports).
# Stripe（可选替代方案，需要 Stripe 支持的主体资质）。
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Only set to 1 when running behind a reverse proxy you control (Caddy/Nginx);
# controls whether X-Forwarded-For is trusted for rate limiting.
# 仅当部署在你自己的反向代理（Caddy/Nginx）后面时设为 1；决定限流是否信任 X-Forwarded-For。
TRUST_PROXY=

# In production set DEMO_MODE=false AND NODE_ENV=production
# (server refuses to boot with DEMO_MODE=true under NODE_ENV=production).
# 生产环境需同时设置 DEMO_MODE=false 和 NODE_ENV=production
# （NODE_ENV=production 下 DEMO_MODE=true 时服务会拒绝启动）。
# NODE_ENV=production
