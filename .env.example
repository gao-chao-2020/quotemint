# QuoteMint environment. Copy to .env and adjust.
PORT=3000
BASE_URL=http://localhost:3000
DATA_DIR=./data

# Billing. Leave Stripe values empty to run with billing disabled.
DEMO_MODE=true
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# In production set DEMO_MODE=false (server refuses to boot with DEMO_MODE=true under NODE_ENV=production).
# NODE_ENV=production
