{
  "name": "quotemint",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "QuoteMint - quote-to-cash for freelancers. Send quotes clients say yes to.",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node --no-warnings --env-file-if-exists=.env src/server.js",
    "dev": "node --no-warnings --watch --env-file-if-exists=.env src/server.js",
    "test": "node --no-warnings --test \"test/**/*.test.js\"",
    "test:unit": "node --no-warnings --test \"test/unit/*.test.js\"",
    "test:integration": "node --no-warnings --test \"test/integration/*.test.js\"",
    "seed": "node --no-warnings --env-file-if-exists=.env scripts/seed.js"
  }
}
