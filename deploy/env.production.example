# QuoteMint production environment.
# Copy to /opt/quotemint/app/.env on the server, adjust, then: systemctl restart quotemint
# Keep every comment on its own line: the Node env-file parser takes the rest of a line literally.

PORT=3000
BASE_URL=https://quotemint.dpdns.org
NODE_ENV=production

# Keep false: the server refuses to boot with DEMO_MODE=true under NODE_ENV=production.
DEMO_MODE=false

# 1 = trust X-Forwarded-For; required behind the Cloudflare tunnel so rate limiting sees real client IPs.
TRUST_PROXY=1

# SQLite database directory (one file inside it).
DATA_DIR=/opt/quotemint/data

# Optional: leave empty to use local SQLite. Set to a Postgres URL to switch drivers.
DATABASE_URL=

# Billing is disabled while all keys are empty. Creem (works from mainland China):
CREEM_API_KEY=
CREEM_PRODUCT_ID=
CREEM_WEBHOOK_SECRET=
# Optional API override; leave empty in production.
CREEM_API_BASE=

# Stripe (alternative; requires an entity Stripe supports):
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
